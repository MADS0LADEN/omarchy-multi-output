#!/usr/bin/python3 -I
"""Create, update, or tear down a PipeWire combine-sink for several outputs."""

from __future__ import annotations

import fcntl
import json
import os
import re
import select
import signal
import stat
import subprocess
import sys
import time

COMBINE_NAME = "omarchy_multi_output"
COMBINE_DESCRIPTION = "omarchy-multi-output"
LEGACY_COMBINE_NAME = "muj_multi_output"
OWNED_SINKS = (COMBINE_NAME, LEGACY_COMBINE_NAME)
SKIP_PARTS = (
    "easyeffects",
    "filter-chain",
    "loopback",
    "null-sink",
    "auto_null",
    "omarchy_speaker_tuning",
    "combine",
)
PACTL = "/usr/bin/pactl"
SINK_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$")
MODULE_ID_RE = re.compile(r"^[0-9]{1,10}$")
STREAM_INDEX_RE = re.compile(r"^[0-9]{1,10}$")
MAX_STATE_BYTES = 65536
MAX_PACTL_BYTES = 262144
MAX_STDERR_BYTES = 4096
MAX_OUTPUTS = 24
MAX_STREAMS = 64
MAX_LABEL = 80
PACTL_TIMEOUT = 4.0
COMMAND_DEADLINE = 8.0
STATE_DIR_PARTS = (".local", "state", "omarchy", "omarchy-multi-output")
LEGACY_DIR_PARTS = (".local", "state", "omarchy", "muj.multi-output")
STATE_NAME = "state.json"
LOCK_NAME = "combine.lock"


def child_env() -> dict[str, str]:
    env = {
        "PATH": "/usr/bin:/bin",
        "HOME": os.environ.get("HOME", ""),
        "LANG": "C",
    }
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        env["XDG_RUNTIME_DIR"] = runtime
    return env


def valid_sink_name(name: str) -> bool:
    return bool(SINK_NAME_RE.fullmatch(name)) and name not in (".", "..")


def plain(value: object, limit: int = MAX_LABEL) -> str:
    text = str(value or "")
    cleaned = []
    for char in text:
        code = ord(char)
        if char in "<>&" or code < 32 or code == 127 or 0x80 <= code <= 0x9F:
            continue
        if 0x202A <= code <= 0x202E or 0x2066 <= code <= 0x2069:
            continue
        cleaned.append(char)
        if len(cleaned) >= limit:
            break
    return "".join(cleaned)


def open_dir_chain(parts: tuple[str, ...] | list[str], home: str | None = None) -> int:
    home_path = home or os.path.expanduser("~")
    fd = os.open(home_path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for name in parts:
            if name in ("", ".", "..") or "/" in name or name.startswith("."):
                if name not in (".local",):
                    raise PermissionError(f"untrusted directory component {name}")
            try:
                next_fd = os.open(
                    name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                    dir_fd=fd,
                )
            except FileNotFoundError:
                os.mkdir(name, 0o700, dir_fd=fd)
                next_fd = os.open(
                    name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                    dir_fd=fd,
                )
            os.close(fd)
            fd = next_fd
            info = os.fstat(fd)
            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid():
                raise PermissionError(f"untrusted directory component {name}")
        info = os.fstat(fd)
        if info.st_mode & 0o077:
            os.fchmod(fd, 0o700)
        return fd
    except BaseException:
        os.close(fd)
        raise


def repair_state_dir(dirfd: int) -> None:
    try:
        names = os.listdir(dirfd)
    except OSError:
        return
    for name in names:
        try:
            info = os.stat(name, dir_fd=dirfd, follow_symlinks=False)
        except OSError:
            continue
        if stat.S_ISREG(info.st_mode) and name == STATE_NAME:
            try:
                fd = os.open(
                    name,
                    os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                    dir_fd=dirfd,
                )
            except OSError:
                continue
            try:
                os.fchmod(fd, 0o600)
            except OSError:
                pass
            finally:
                os.close(fd)
            continue
        if not stat.S_ISREG(info.st_mode):
            try:
                os.unlink(name, dir_fd=dirfd)
            except OSError:
                pass


def read_bounded(dirfd: int, name: str) -> bytes | None:
    try:
        fd = os.open(
            name,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC,
            dir_fd=dirfd,
        )
    except FileNotFoundError:
        return None
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.geteuid()
            or info.st_nlink != 1
            or info.st_size > MAX_STATE_BYTES
        ):
            raise PermissionError("refusing state file")
        os.set_blocking(fd, True)
        data = b""
        while len(data) <= MAX_STATE_BYTES:
            chunk = os.read(fd, min(65536, MAX_STATE_BYTES + 1 - len(data)))
            if not chunk:
                break
            data += chunk
        if len(data) > MAX_STATE_BYTES:
            raise PermissionError("state file grew past the limit")
        return data
    finally:
        os.close(fd)


def write_atomic(dirfd: int, name: str, data: bytes) -> None:
    if len(data) > MAX_STATE_BYTES:
        raise ValueError("payload too large")
    tmp = f".{name}.{os.urandom(8).hex()}.tmp"
    fd = os.open(
        tmp,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=dirfd,
    )
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        os.fsync(fd)
        os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    finally:
        os.close(fd)


def parse_state_bytes(raw: bytes | None) -> dict | None:
    if raw is None:
        return None
    try:
        data = json.loads(raw.decode("utf-8", "strict"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    slaves = data.get("slaves")
    if not isinstance(slaves, list) or len(slaves) > MAX_OUTPUTS:
        return None
    names = []
    for item in slaves:
        if not isinstance(item, str) or not valid_sink_name(item):
            return None
        names.append(item)
    previous = data.get("previousDefault") or ""
    if previous and not isinstance(previous, str):
        return None
    previous = str(previous)
    if previous and not valid_sink_name(previous):
        previous = ""
    return {"slaves": names, "previousDefault": previous}


def load_state() -> dict:
    dirfd = open_dir_chain(STATE_DIR_PARTS)
    try:
        repair_state_dir(dirfd)
        try:
            parsed = parse_state_bytes(read_bounded(dirfd, STATE_NAME))
        except PermissionError:
            return {"slaves": [], "previousDefault": ""}
        if parsed is not None:
            return parsed
    finally:
        os.close(dirfd)
    try:
        legacy_fd = open_dir_chain(LEGACY_DIR_PARTS)
    except OSError:
        return {"slaves": [], "previousDefault": ""}
    try:
        try:
            parsed = parse_state_bytes(read_bounded(legacy_fd, STATE_NAME))
        except PermissionError:
            parsed = None
        if parsed is None:
            return {"slaves": [], "previousDefault": ""}
        save_state(parsed)
        try:
            os.unlink(STATE_NAME, dir_fd=legacy_fd)
        except OSError:
            pass
        return parsed
    finally:
        os.close(legacy_fd)


def save_state(state: dict) -> None:
    payload = json.dumps(
        {
            "slaves": [name for name in state.get("slaves", []) if valid_sink_name(name)][:MAX_OUTPUTS],
            "previousDefault": state.get("previousDefault") or "",
        },
        indent=2,
        ensure_ascii=False,
    )
    encoded = (payload + "\n").encode("utf-8")
    dirfd = open_dir_chain(STATE_DIR_PARTS)
    try:
        repair_state_dir(dirfd)
        try:
            current = read_bounded(dirfd, STATE_NAME)
        except PermissionError:
            current = b""
        if current == encoded:
            return
        write_atomic(dirfd, STATE_NAME, encoded)
    finally:
        os.close(dirfd)


def _kill_group(proc: subprocess.Popen[bytes], sig: int) -> None:
    try:
        os.killpg(proc.pid, sig)
    except OSError:
        try:
            proc.send_signal(sig)
        except OSError:
            pass


def run_pactl(args: list[str], timeout: float = PACTL_TIMEOUT) -> subprocess.CompletedProcess[str]:
    command = [PACTL, *args]
    started = time.monotonic()
    proc = subprocess.Popen(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
        env=child_env(),
    )
    stdout = bytearray()
    stderr = bytearray()
    overflow = False
    assert proc.stdout is not None and proc.stderr is not None
    try:
        while proc.poll() is None:
            remaining = timeout - (time.monotonic() - started)
            if remaining <= 0:
                break
            ready, _, _ = select.select(
                [proc.stdout, proc.stderr], [], [], min(remaining, 0.2)
            )
            if proc.stdout in ready:
                chunk = os.read(proc.stdout.fileno(), 65536)
                if chunk:
                    stdout += chunk
                    if len(stdout) > MAX_PACTL_BYTES:
                        overflow = True
                        break
            if proc.stderr in ready:
                chunk = os.read(proc.stderr.fileno(), 4096)
                if chunk:
                    stderr += chunk[: MAX_STDERR_BYTES + 1 - len(stderr)]
                    if len(stderr) > MAX_STDERR_BYTES:
                        overflow = True
                        break
        if proc.poll() is None:
            _kill_group(proc, signal.SIGTERM)
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                _kill_group(proc, signal.SIGKILL)
                proc.wait(timeout=2)
        else:
            while len(stdout) <= MAX_PACTL_BYTES:
                chunk = os.read(proc.stdout.fileno(), 65536)
                if not chunk:
                    break
                stdout += chunk
            while len(stderr) <= MAX_STDERR_BYTES:
                chunk = os.read(proc.stderr.fileno(), 4096)
                if not chunk:
                    break
                stderr += chunk
            if len(stdout) > MAX_PACTL_BYTES or len(stderr) > MAX_STDERR_BYTES:
                overflow = True
    finally:
        if proc.poll() is None:
            _kill_group(proc, signal.SIGKILL)
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass
    if overflow:
        return subprocess.CompletedProcess(command, 1, "", "output exceeded limit")
    return subprocess.CompletedProcess(
        command,
        proc.returncode if proc.returncode is not None else 1,
        stdout.decode("utf-8", "replace"),
        stderr.decode("utf-8", "replace")[:MAX_STDERR_BYTES],
    )


def pactl_json(kind: str) -> list:
    if kind not in ("sinks", "sink-inputs"):
        return []
    result = run_pactl(["-f", "json", "list", kind])
    if result.returncode != 0 or not result.stdout.strip():
        return []
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return []
    if not isinstance(data, list) or len(data) > 4096:
        return []
    return data


def skip_sink(name: str) -> bool:
    if not valid_sink_name(name) or name in OWNED_SINKS:
        return True
    lowered = name.lower()
    return any(part in lowered for part in SKIP_PARTS)


def sink_description(sink: dict) -> str:
    props = sink.get("properties") if isinstance(sink.get("properties"), dict) else {}
    return plain(
        sink.get("description")
        or props.get("device.description")
        or props.get("node.nick")
        or sink.get("name")
        or "Output"
    )


def list_sinks() -> list[dict]:
    rows = []
    for sink in pactl_json("sinks"):
        if not isinstance(sink, dict):
            continue
        name = sink.get("name")
        if not isinstance(name, str) or skip_sink(name):
            continue
        rows.append({"name": name, "description": sink_description(sink)})
        if len(rows) >= MAX_OUTPUTS:
            break
    return rows


def default_sink() -> str:
    result = run_pactl(["get-default-sink"])
    name = result.stdout.strip() if result.returncode == 0 else ""
    return name if valid_sink_name(name) else ""


def parse_combine_modules(text: str) -> list[tuple[str, str]]:
    found = []
    for line in text.splitlines()[:512]:
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        index, name = parts[0], parts[1]
        argument = parts[2] if len(parts) > 2 else ""
        if not MODULE_ID_RE.fullmatch(index) or name != "module-combine-sink":
            continue
        if any(f"sink_name={owned}" in argument for owned in OWNED_SINKS):
            found.append((index, argument[:4096]))
    return found


def combine_modules() -> list[tuple[str, str]]:
    result = run_pactl(["list", "short", "modules"])
    if result.returncode != 0:
        return []
    return parse_combine_modules(result.stdout)


def combine_module() -> tuple[str | None, str]:
    modules = combine_modules()
    if not modules:
        return None, ""
    return modules[0]


def combine_module_id() -> str | None:
    return combine_module()[0]


def exclusive_lock() -> int:
    dirfd = open_dir_chain(STATE_DIR_PARTS)
    try:
        fd = os.open(
            LOCK_NAME,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=dirfd,
        )
    finally:
        os.close(dirfd)
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.geteuid()
            or info.st_nlink != 1
        ):
            raise PermissionError("refusing lock file")
        os.fchmod(fd, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd
    except BaseException:
        os.close(fd)
        raise


def argument_value(argument: str, key: str) -> str:
    prefix = key + "="
    for part in argument.split():
        if part.startswith(prefix):
            return part.split("=", 1)[1]
    return ""


def slaves_from_argument(argument: str) -> list[str]:
    names = []
    for name in argument_value(argument, "slaves").split(","):
        if valid_sink_name(name):
            names.append(name)
        if len(names) >= MAX_OUTPUTS:
            break
    return names


def unload_combine() -> None:
    for module_id, _argument in combine_modules():
        run_pactl(["unload-module", module_id])


def move_streams(sink_name: str) -> None:
    if not valid_sink_name(sink_name):
        return
    moved = 0
    for item in pactl_json("sink-inputs"):
        if not isinstance(item, dict):
            continue
        props = item.get("properties") if isinstance(item.get("properties"), dict) else {}
        app = plain(props.get("application.name") or "", 64)
        if not app or app == "EasyEffects":
            continue
        index = item.get("index")
        if not STREAM_INDEX_RE.fullmatch(str(index)):
            continue
        run_pactl(["move-sink-input", str(index), sink_name])
        moved += 1
        if moved >= MAX_STREAMS:
            break


def set_default(sink_name: str) -> None:
    if not valid_sink_name(sink_name):
        return
    run_pactl(["set-default-sink", sink_name])
    move_streams(sink_name)


def restore_previous(state: dict, available_names: set[str]) -> None:
    previous = state.get("previousDefault") or ""
    if previous in available_names:
        set_default(previous)
        return
    for sink in list_sinks():
        set_default(sink["name"])
        return


def apply(state: dict, available: list[dict]) -> dict:
    available_names = {row["name"] for row in available}
    selected = [name for name in state["slaves"] if name in available_names][:MAX_OUTPUTS]
    current_default = default_sink()

    if len(selected) < 2:
        if combine_module_id():
            unload_combine()
            restore_previous(state, available_names)
        return state

    if current_default and current_default not in OWNED_SINKS:
        state["previousDefault"] = current_default

    unload_combine()
    slaves = ",".join(selected)
    result = run_pactl(
        [
            "load-module",
            "module-combine-sink",
            f"sink_name={COMBINE_NAME}",
            f"slaves={slaves}",
            f"sink_properties=device.description={COMBINE_DESCRIPTION}",
            "latency_compensate=true",
        ]
    )
    if result.returncode != 0:
        raise SystemExit("failed to load combine-sink")
    set_default(COMBINE_NAME)
    return state


def status_payload() -> dict:
    deadline = time.monotonic() + COMMAND_DEADLINE
    state = load_state()
    modules = combine_modules()
    module_id, argument = modules[0] if modules else (None, "")
    if module_id and not state["slaves"]:
        state["slaves"] = slaves_from_argument(argument)
        save_state(state)
    if time.monotonic() > deadline:
        return empty_error()
    available = list_sinks()
    available_names = {row["name"] for row in available}
    present = [name for name in state["slaves"] if name in available_names]
    running = slaves_from_argument(argument) if module_id else []
    running_name = argument_value(argument, "sink_name") if module_id else ""
    duplicates = len(modules) > 1
    mismatch = len(present) >= 2 and (
        set(present) != set(running) or running_name != COMBINE_NAME
    )
    if duplicates or mismatch:
        if len(present) >= 2:
            state = apply(state, available)
            save_state(state)
        elif duplicates:
            unload_combine()
        module_id, argument = combine_module()
    selected = set(state["slaves"])
    return {
        "ok": True,
        "enabled": bool(module_id),
        "sink": COMBINE_NAME,
        "slaves": state["slaves"][:MAX_OUTPUTS],
        "previousDefault": state.get("previousDefault") or "",
        "available": [
            {
                "name": row["name"],
                "description": row["description"],
                "selected": row["name"] in selected,
            }
            for row in available[:MAX_OUTPUTS]
        ],
    }


def empty_error() -> dict:
    return {
        "ok": False,
        "enabled": False,
        "sink": COMBINE_NAME,
        "slaves": [],
        "previousDefault": "",
        "available": [],
    }


def emit(payload: dict) -> int:
    encoded = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    if len(encoded) > MAX_STATE_BYTES:
        encoded = json.dumps(empty_error(), ensure_ascii=True).encode("utf-8")
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.write(b"\n")
    return 0 if payload.get("ok") else 1


def cmd_status() -> int:
    return emit(status_payload())


def cmd_toggle(name: str) -> int:
    if not valid_sink_name(name) or skip_sink(name):
        raise SystemExit("unknown output")
    state = load_state()
    slaves = list(state["slaves"])
    if name in slaves:
        slaves.remove(name)
    else:
        if len(slaves) >= MAX_OUTPUTS:
            raise SystemExit("too many outputs")
        slaves.append(name)
    state["slaves"] = slaves
    available = list_sinks()
    names = {row["name"] for row in available}
    if name not in names:
        save_state(state)
        return emit(status_payload())
    state = apply(state, available)
    save_state(state)
    return emit(status_payload())


def cmd_on() -> int:
    state = load_state()
    available = list_sinks()
    state = apply(state, available)
    save_state(state)
    return emit(status_payload())


def cmd_off() -> int:
    state = load_state()
    available = list_sinks()
    names = {row["name"] for row in available}
    unload_combine()
    restore_previous(state, names)
    save_state(state)
    return emit(status_payload())


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    lock_fd = exclusive_lock()
    try:
        if action == "status":
            return cmd_status()
        if action == "toggle":
            if len(sys.argv) < 3:
                raise SystemExit("usage: combine toggle <sink-name>")
            return cmd_toggle(sys.argv[2])
        if action == "on":
            return cmd_on()
        if action == "off":
            return cmd_off()
        raise SystemExit("usage: combine [status|toggle <sink>|on|off]")
    finally:
        os.close(lock_fd)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit as exc:
        if isinstance(exc.code, str):
            emit(empty_error())
            raise SystemExit(1) from None
        raise
    except (subprocess.TimeoutExpired, PermissionError, ValueError, OSError):
        emit(empty_error())
        raise SystemExit(1)
